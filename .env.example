# Copy to .env.local.
# Without a Sanity project the site runs on the built-in sample content in src/content.

# From https://www.sanity.io/manage (or `npx sanity init`)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret for the Sanity webhook that refreshes the site after an edit
# (POST /api/revalidate with header "Authorization: Bearer <secret>")
SANITY_REVALIDATE_SECRET=

# Only for `npm run sanity:seed` (Editor token from sanity.io/manage > API > Tokens)
SANITY_WRITE_TOKEN=
